<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 1: Base solid card background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#16152B" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="#3A355A" />
        </shape>
    </item>
    <!-- Layer 2: Subtle inner top light highlight (glass effect) -->
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#15FFFFFF"
                android:endColor="#00000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</layer-list>
