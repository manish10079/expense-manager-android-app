rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /******************************************************************
     * COUPONS COLLECTION
     ******************************************************************/
    match /coupons/{code} {

      // No client reads. Redemption goes through the redeemProPass Cloud
      // Function (Admin SDK bypasses these rules), so phones never need to
      // read coupon docs. This keeps repeatAllowedUids / maxUses / currentUses
      // / expiry hidden from everyone, authenticated or not.
      allow get: if false;

      // Prevent listing all coupons
      allow list: if false;

      // Coupons are written ONLY by the redeemProPass Cloud Function, which uses the
      // Admin SDK and bypasses these rules. Clients may not touch a coupon at all: the
      // old allowance to increment currentUses by exactly +1 still let any client burn a
      // code's usage one increment at a time, until it looked exhausted to real users.
      allow update: if false;

      // Coupons can only be created/deleted by backend/admin
      allow create, delete: if false;

      /**************************************************************
       * COUPON REDEMPTION TRACKING
       * Path:
       * coupons/{couponCode}/redemptions/{uid}
       **************************************************************/
      match /redemptions/{uid} {

        // User can check only their own redemption record
        allow get: if request.auth != null
                   && request.auth.uid == uid;

        // Redemptions are written ONLY by the redeemProPass Cloud Function (Admin SDK).
        // A client that could create or overwrite its own record could fake a redemption,
        // or erase one and spend the same code twice.
        allow create, update: if false;

        // No deletes or listing
        allow list, delete: if false;
      }
    }

    /******************************************************************
     * USER PROFILE DOCUMENT
     * Path:
     * users/{uid}
     ******************************************************************/
    match /users/{uid} {

      // Read own profile
      allow get: if request.auth != null
                 && request.auth.uid == uid;

      // Prevent fetching all user profiles
      allow list: if false;

      // Create own profile document
      // Ensures stored uid matches authenticated uid.
      // Pro fields (accountTier / proExpiryTimestamp / isSubscription) are
      // server-authoritative: a client may not create a doc as PREMIUM or with
      // a proExpiryTimestamp / subscription flag (only the redeemProPass Cloud
      // Function writes them, bypassing rules via the Admin SDK).
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && (!('accountTier' in request.resource.data)
                        || request.resource.data.accountTier == 'FREE')
                    && (!('proExpiryTimestamp' in request.resource.data)
                        || request.resource.data.proExpiryTimestamp == 0)
                    && (!('isSubscription' in request.resource.data)
                        || request.resource.data.isSubscription == false);

      // Update own profile document
      // Prevents changing uid field. Pro fields may not be modified by clients;
      // the sole exception is pushing accountTier=FREE (expired-premium
      // downgrade) so the cloud never re-grants Pro on the next pull.
      allow update: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && resource.data.uid == uid
                    && !request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasAny(['proExpiryTimestamp', 'isSubscription'])
                    && (!request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasAny(['accountTier'])
                        || request.resource.data.accountTier == 'FREE');

      // Allow user to delete their own profile
      allow delete: if request.auth != null
                    && request.auth.uid == uid;
    }

    /******************************************************************
     * USER SUBCOLLECTIONS
     *
     * NOTE: this recursive rule grants clients read+write on EVERY
     * subcollection under users/{uid} (transactions, budgets, goals,
     * devices, fcmTokens, ...). Firestore rules are ADDITIVE — a nested
     * rule can never *deny* a path this one already allows — so anything
     * that must be server-authoritative (e.g. the RevenueCat entitlement
     * snapshot) cannot live under users/{uid}. That is why rc_customers
     * below is a top-level collection.
     ******************************************************************/
    match /users/{uid}/{document=**} {

      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    /******************************************************************
     * FEEDBACKS COLLECTION
     *
     * Allows any signed-in user (including anonymous/guest users) to
     * submit feedback. Only readable from the Firebase Admin console.
     ******************************************************************/
    match /feedbacks/{document} {
      // Any signed-in user (including anonymous/guest) may submit feedback,
      // but only under their own uid — no impersonating another user.
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    /******************************************************************
     * REVENUECAT ENTITLEMENT SNAPSHOT
     * Path:
     * rc_customers/{uid}
     *
     * Written ONLY by the RevenueCat Firebase Extension. The extension uses
     * the Admin SDK, which bypasses these rules entirely, so no write rule
     * is needed for it to work. Clients get read-only access to their own
     * document and can neither write nor enumerate others.
     *
     * Doc id === Firebase UID === RevenueCat app user id (BillingManager
     * calls Purchases.logIn(firebaseUid), so the two always match).
     ******************************************************************/
    match /rc_customers/{uid} {

      // Read own entitlement snapshot
      allow get: if request.auth != null
                 && request.auth.uid == uid;

      // No listing other customers, and no client writes at all
      allow list, write: if false;
    }

    /******************************************************************
     * REVENUECAT WEBHOOK EVENTS LOG (optional)
     * Path:
     * rc_events/{eventId}
     *
     * Server-side audit trail of subscription lifecycle events
     * (INITIAL_PURCHASE, RENEWAL, CANCELLATION, EXPIRATION, ...) written by
     * the extension via Admin SDK. No client access whatsoever — this is a
     * backend/debugging log, not app-facing data.
     ******************************************************************/
    match /rc_events/{eventId} {
      allow read, write: if false;
    }

    /******************************************************************
     * DENY EVERYTHING ELSE
     ******************************************************************/
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
