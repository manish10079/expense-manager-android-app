{
  "hosting": [
    {
      "site": "expense-tracker-2ea00",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "/p/:code",
          "destination": "https://play.google.com/store/apps/details?id=com.mknlabs.expensetracker&referrer=utm_source%3Dfirebase%26utm_content%3D:code",
          "type": 302
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "site": "mknlabs",
      "public": "portfolio",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ]
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "remoteconfig": {
    "template": "remote_config.json"
  }
}
